def build_stats(sessions, start_date, end_date, kinds, extras=(), sources=None):
    per_agent_count = defaultdict(int)
    per_agent_day = defaultdict(lambda: defaultdict(int))
    projects_per_agent = defaultdict(set)
    records_per_agent = defaultdict(int)
    user_msgs_per_agent = defaultdict(int)
    bytes_per_agent = defaultdict(int)
    files_per_agent = defaultdict(int)

    for sess in sessions:
        label = LABELS[sess.agent]
        per_agent_count[label] += 1
        projects_per_agent[label].add(sess.project)
        records_per_agent[label] += sess.records
        user_msgs_per_agent[label] += sess.user_messages
        kept = sess.kept_artifacts(kinds)
        bytes_per_agent[label] += sum(a.size for a in kept)
        files_per_agent[label] += len(kept)
        day = sess.started.astimezone().date().isoformat() if sess.started \
            else "unknown"
        per_agent_day[label][day] += 1

    # Files that belong to a project rather than to one session (agent memory,
    # session indexes) still count towards what the zip holds.
    for group, art in extras:
        label = LABELS.get(str(group).split(":", 1)[0])
        if label is None:
            continue
        bytes_per_agent[label] += art.size
        files_per_agent[label] += 1

    # Where each agent's logs came from, and how many survived each stage.
    # Counts only — never the name of anything that was left out.
    per_agent = {}
    for key, info in sorted((sources or {}).items()):
        label = LABELS[key]
        per_agent[label] = {
            "roots": info.get("roots", []),
            "root_source": info.get("root_source"),
            "sessions_found": info.get("found", 0),
            "sessions_in_window": info.get("in_window", 0),
            "sessions_selected": info.get("selected", 0),
            "sessions_exported": per_agent_count.get(label, 0),
            "projects_exported": len(projects_per_agent.get(label, ())),
            "files_exported": files_per_agent.get(label, 0),
            "bytes_exported": bytes_per_agent.get(label, 0),
            "message_records": records_per_agent.get(label, 0),
            "user_messages": user_msgs_per_agent.get(label, 0),
        }

    days = _window_days(sessions, start_date, end_date)
    per_agent_day_full = {}
    for label, counts in sorted(per_agent_day.items()):
        row = {day: counts.get(day, 0) for day in days}
        if "unknown" in counts:
            row["unknown"] = counts["unknown"]
        per_agent_day_full[label] = row

    total_day = {day: sum(row.get(day, 0) for row in per_agent_day.values())
                 for day in days}
    return {
        "totals": {
            "sessions": len(sessions),
            "projects": len({s.project for s in sessions}),
            "agents": len(per_agent_count),
            "files": sum(files_per_agent.values()),
            "bytes": sum(bytes_per_agent.values()),
            "message_records": sum(records_per_agent.values()),
            "user_messages": sum(user_msgs_per_agent.values()),
            "sessions_found": sum(v["sessions_found"] for v in per_agent.values()),
            "sessions_in_window": sum(v["sessions_in_window"]
                                      for v in per_agent.values()),
            "sessions_selected": sum(v["sessions_selected"]
                                     for v in per_agent.values()),
        },
        "per_agent": per_agent,
        "sessions_per_agent": dict(sorted(per_agent_count.items())),
        "projects_per_agent": {k: len(v) for k, v in sorted(projects_per_agent.items())},
        "message_records_per_agent": dict(sorted(records_per_agent.items())),
        "user_messages_per_agent": dict(sorted(user_msgs_per_agent.items())),
        "bytes_per_agent": dict(sorted(bytes_per_agent.items())),
        "files_per_agent": dict(sorted(files_per_agent.items())),
        "sessions_per_agent_per_day": per_agent_day_full,
        "sessions_per_day": total_day,
    }


def _window_days(sessions, start_date, end_date):
    """Every day in the window, so gaps are visible as explicit zeros."""
    dates = [s.started.astimezone().date() for s in sessions if s.started]
    first = start_date or (min(dates) if dates else None)
    last = end_date or (max(dates) if dates else None)
    if first is None or last is None or last < first:
        return []
    if (last - first).days > 3660:                      # a decade of keys is noise
        return sorted({d.isoformat() for d in dates})
    out, day = [], first
    while day <= last:
        out.append(day.isoformat())
        day += timedelta(days=1)
    return out


def stats_text(stats, window):
    lines = ["agent-logs export summary", "=" * 40, ""]
    lines.append(f"window            {window['start'] or 'all time'} .. "
                 f"{window['end'] or 'today'}  (local dates, inclusive)")
    totals = stats["totals"]
    lines += [
        f"sessions          {totals['sessions']}",
        f"projects          {totals['projects']}",
        f"files             {totals['files']}",
        f"uncompressed      {human_bytes(totals['bytes'])}",
        f"user messages     {totals['user_messages']}",
        f"message records   {totals['message_records']} (approximate; exact "
        f"counts come from the parser)",
        "", "sessions per agent", "-" * 40,
    ]
    for label, count in stats["sessions_per_agent"].items():
        lines.append(f"  {label:<20} {count:>6}  "
                     f"({stats['projects_per_agent'][label]} project(s), "
                     f"{stats['user_messages_per_agent'][label]} user message(s), "
                     f"{human_bytes(stats['bytes_per_agent'][label])})")

    if stats.get("per_agent"):
        lines += ["", "where each agent's logs came from, and what got through",
                  "-" * 72,
                  f"  {'agent':<20}{'on disk':>9}{'in window':>11}"
                  f"{'selected':>10}{'exported':>10}   source"]
        for label, info in stats["per_agent"].items():
            lines.append(
                f"  {label:<20}{info['sessions_found']:>9}"
                f"{info['sessions_in_window']:>11}{info['sessions_selected']:>10}"
                f"{info['sessions_exported']:>10}   {info['root_source']}")
            for root in info["roots"]:
                lines.append(f"  {'':<20}{root}")
    lines += ["", "sessions per day", "-" * 40]
    labels = list(stats["sessions_per_agent"])
    header = "  date        " + "".join(f"{l[:12]:>14}" for l in labels) + "         total"
    lines.append(header)
    for day, total in stats["sessions_per_day"].items():
        if total == 0:
            continue
        row = "".join(
            f"{stats['sessions_per_agent_per_day'].get(l, {}).get(day, 0):>14}"
            for l in labels)
        lines.append(f"  {day}{row}{total:>14}")
    unknown = {l: r.get("unknown", 0)
               for l, r in stats["sessions_per_agent_per_day"].items()
               if r.get("unknown")}
    if unknown:
        lines.append("")
        lines.append("  sessions with no usable timestamp: "
                     + ", ".join(f"{l} {n}" for l, n in unknown.items()))
    return "\n".join(lines) + "\n"


def zip_readme(manifest, stats):
    """The note that travels inside the zip.

    Whoever opens this is either the person who made it, checking what they are
    about to send, or the person they sent it to. Neither needs to know how it
    will be processed afterwards, so this says what the archive holds and
    nothing more.
    """
    window = manifest["window"]
    span = (f"{window['start']} to {window['end']}" if window["start"]
            else f"everything up to {window['end']}")
    per_agent = "\n".join(
        f"      {label:<20} {count} session(s)"
        for label, count in stats["sessions_per_agent"].items())
    totals = stats["totals"]
    return f"""\
agent-logs export
=================

Coding-agent session logs, copied from the machine that made this file. They are the originals, byte for byte: nothing was rewritten, summarised, filtered by content, or uploaded anywhere. Making this archive was the only thing that happened.

  Days covered   {span}
  Contents       {totals['sessions']} session(s) from {totals['projects']} project(s), {totals['files']} file(s), {totals['user_messages']} message(s) typed

{per_agent}

What is in here
---------------

  logs/<agent>/   the session transcripts, in their original folder layout
  manifest.json   one entry per file: which agent and session it came from, the project folder it belongs to, timestamps, size, checksum
  stats.json      session counts per agent, and per agent per day
  stats.txt       the same counts, as a table

Because these are complete transcripts, they contain whatever those sessions contained: the messages that were typed, the model's replies, the commands the agent ran, file paths on that machine, and parts of any files it read.

Anything left out during the export is not captured. The manifest records how many projects and sessions were skipped, never which ones.

Two of the agents keep conversations in a database rather than in files (OpenCode, Cursor). Those were read without modifying them and written out as JSON, so every session is a file like all the others.
"""


# --------------------------------------------------------------------------- #
# Writing the zip
# --------------------------------------------------------------------------- #

def write_zip(out_path, sessions, extras, kinds, window, quiet=False,
              sources=None):
    manifest_files = []
    skipped = []
    groups_used = {s.group for s in sessions}
    extra_pairs = [(group, a) for group, items in sorted(extras.items())
                   if group in groups_used for a in items if a.kind in kinds]
    stats = build_stats(sessions, window["start_date"], window["end_date"],
                        kinds, extra_pairs, sources)
    # (session, agent_key, artifact) — project-level extras have no session.
    queue = [(s, s.agent, a) for s in sessions for a in s.kept_artifacts(kinds)]
    queue += [(None, str(g).split(":", 1)[0], a) for g, a in extra_pairs]

    seen_arcs = set()
    out_path.parent.mkdir(parents=True, exist_ok=True)
    # Build under a temporary name and rename at the end, so an interrupted run
    # cannot leave a truncated zip sitting there looking ready to send.
    partial = out_path.with_name(out_path.name + ".part")
    with zipfile.ZipFile(partial, "w", zipfile.ZIP_DEFLATED,
                         allowZip64=True) as zf:
        total = len(queue)
        for index, (sess, agent_key, art) in enumerate(queue, 1):
            arc = _unique(art.arc, seen_arcs)
            if not quiet and (index % 25 == 0 or index == total):
                print(f"\r  writing {index}/{total} files…", end="", file=sys.stderr)
            try:
                digest, size = _add(zf, arc, art)
            except OSError as exc:
                skipped.append({"path": str(art.path), "reason": str(exc)})
                continue
            entry = {
                "arcname": arc,
                "agent": LABELS.get(agent_key),
                "agent_key": agent_key,
                "kind": art.kind,
                "bytes": size,
                "sha256": digest,
                "source_path": str(art.path) if art.path else None,
                "synthesized": art.path is None,
            }
            if sess is not None:
                entry.update({
                    "session_id": sess.session_id,
                    "project": sess.project,
                    "started_at": sess.started.isoformat() if sess.started else None,
                    "ended_at": sess.ended.isoformat() if sess.ended else None,
                })
                if sess.ts_from_mtime:
                    entry["timestamps_from_file_mtime"] = True
            manifest_files.append(entry)
        if not quiet and total:
            print(file=sys.stderr)

        manifest = {
            "tool": "agent-logs",
            "format_version": 1,
            "tool_version": VERSION,
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "window": {"start": window["start_date"].isoformat()
                       if window["start_date"] else None,
                       "end": window["end_date"].isoformat()
                       if window["end_date"] else None,
                       "timezone": str(datetime.now().astimezone().tzinfo)},
            "included_kinds": sorted(kinds),
            "counts": {
                "sessions": len(sessions),
                "projects": len({s.project for s in sessions}),
                "files": len(manifest_files),
                "user_messages": sum(s.user_messages for s in sessions),
                "excluded_projects": window.get("excluded_projects", 0),
                "excluded_sessions": window.get("excluded_sessions", 0),
                "skipped_files": len(skipped),
            },
            "environment": {
                "os": platform.system(),
                "os_release": platform.release(),
                "python": platform.python_version(),
                "command": " ".join(sys.argv),
            },
            "skipped": skipped,
            "files": manifest_files,
        }
        zf.writestr("manifest.json", json.dumps(manifest, indent=2, ensure_ascii=False))
        zf.writestr("stats.json", json.dumps(
            {"window": manifest["window"], "generated_at": manifest["generated_at"],
             **stats}, indent=2, ensure_ascii=False))
        zf.writestr("stats.txt", stats_text(
            stats, {"start": manifest["window"]["start"],
                    "end": manifest["window"]["end"]}))
        zf.writestr("README.txt", zip_readme(manifest, stats))
    os.replace(partial, out_path)
    return stats, manifest, skipped


def _unique(arc, seen):
    if arc not in seen:
        seen.add(arc)
        return arc
    stem, dot, suffix = arc.rpartition(".")
    counter = 2
    while True:
        candidate = f"{stem}-{counter}{dot}{suffix}" if dot else f"{arc}-{counter}"
        if candidate not in seen:
            seen.add(candidate)
            return candidate
        counter += 1


def _add(zf, arc, art):
    """Stream one artifact into the zip, hashing it on the way through."""
    digest = hashlib.sha256()
    if art.data is not None:
        digest.update(art.data)
        zf.writestr(arc, art.data)
        return digest.hexdigest(), len(art.data)
    size = 0
    with open(art.path, "rb") as src, zf.open(arc, "w") as dst:
        while True:
            chunk = src.read(1 << 20)
            if not chunk:
                break
            digest.update(chunk)
            dst.write(chunk)
            size += len(chunk)
    return digest.hexdigest(), size


