def _env_paths(*names):
    """Directories named by env vars, honouring ':'/';'/',' separated lists."""
    out = []
    for name in names:
        raw = os.environ.get(name)
        if not raw:
            continue
        for chunk in re.split(r"[%s,]" % re.escape(os.pathsep), raw):
            chunk = chunk.strip()
            if chunk:
                out.append(Path(chunk).expanduser())
    return out


def _data_dirs():
    """Per-user data roots, in the order a CLI tool would pick them."""
    home = Path.home()
    dirs = _env_paths("XDG_DATA_HOME") or [home / ".local" / "share"]
    if os.name == "nt":
        dirs += _env_paths("LOCALAPPDATA", "APPDATA")
    if sys.platform == "darwin":
        dirs.append(home / "Library" / "Application Support")
    return dirs


def _app_dirs():
    """Per-user config roots, where Electron apps (Cursor) store state."""
    home = Path.home()
    if os.name == "nt":
        return _env_paths("APPDATA", "LOCALAPPDATA")
    if sys.platform == "darwin":
        return [home / "Library" / "Application Support"]
    return _env_paths("XDG_CONFIG_HOME") or [home / ".config"]


def default_roots(agent):
    """Candidate log roots for one agent. Non-existent ones are dropped later."""
    home = Path.home()
    if agent == "claude":
        return [p / "projects" for p in _env_paths("CLAUDE_CONFIG_DIR")] \
            or [home / ".claude" / "projects"]
    if agent == "codex":
        return [p / "sessions" for p in _env_paths("CODEX_HOME")] \
            or [home / ".codex" / "sessions"]
    if agent == "opencode":
        roots = _env_paths("OPENCODE_DATA", "OPENCODE_CONFIG")
        roots += [d / "opencode" for d in _data_dirs()]
        return roots
    if agent == "gemini":
        return [p / "tmp" for p in _env_paths("GEMINI_DIR")] \
            or [home / ".gemini" / "tmp"]
    if agent == "droid":
        return [home / ".factory" / "sessions"]
    if agent == "copilot":
        # Newer builds use ~/.copilot/history-session-state; older ones history/.
        return [home / ".copilot" / "history",
                home / ".copilot" / "history-session-state"]
    if agent == "cursor":
        # Two unrelated layouts: the cursor-agent CLI writes JSONL under
        # ~/.cursor/projects, the IDE keeps chats in a SQLite state store.
        # Both are checked; whichever exist are scanned and merged.
        return [home / ".cursor" / "projects"] \
            + [d / "Cursor" / "User" for d in _app_dirs()]
    if agent == "pi":
        return [home / ".pi" / "sessions"]
    return []


