def parse_date_arg(value, what):
    """YYYY-MM-DD, 'Nd' (N days back), or 'all'."""
    if value is None:
        return None
    text = str(value).strip().lower()
    if text in ("all", "none", ""):
        return None
    match = re.fullmatch(r"(\d+)\s*d(ays?)?", text)
    if match:
        # "31d" is the last 31 days *including today*, so the window really is
        # 31 days long rather than 32.
        return date.today() - timedelta(days=max(int(match.group(1)) - 1, 0))
    try:
        return date.fromisoformat(text)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"{what}: expected YYYY-MM-DD, Nd or all — got {value!r}")


def local_window(start_date, end_date):
    """Local-midnight bounds as aware UTC datetimes; end is exclusive."""
    tz = datetime.now().astimezone().tzinfo
    start = datetime.combine(start_date, dtime.min, tz).astimezone(timezone.utc) \
        if start_date else None
    end = datetime.combine(end_date + timedelta(days=1), dtime.min, tz) \
        .astimezone(timezone.utc) if end_date else None
    return start, end


def describe_window(start_date, end_date, defaulted):
    """One line saying exactly which days are being considered."""
    zone = datetime.now().astimezone().strftime("%Z") or "local time"
    if start_date is None:
        span = f"everything up to and including {end_date}"
    else:
        days = (end_date - start_date).days + 1
        span = f"{start_date} to {end_date} ({days} day{'s' if days != 1 else ''})"
    suffix = "  [default: last 31 days; set --start-date / --end-date to change]" \
        if defaulted else f"  [{zone} dates, both ends inclusive]"
    return f"Window: {span}{suffix}"


def in_window(sess, start, end):
    """A session counts if its activity overlaps the window at all."""
    first, last = sess.started, sess.ended or sess.started
    if first is None and last is None:
        return True                      # undateable: keep, flagged in manifest
    if start and (last or first) < start:
        return False
    if end and (first or last) >= end:
        return False
    return True


