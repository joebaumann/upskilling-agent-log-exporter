def ask_yes_no(question, default=True):
    suffix = "[Y/n]" if default else "[y/N]"
    while True:
        try:
            answer = input(f"{question} {suffix} ").strip().lower()
        except EOFError:
            return default
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        print("  please answer y or n.")


def parse_selection(text, count):
    """'2 5 7-9' or '2,5,7-9' -> {2,5,7,8,9}; None if anything is out of range."""
    picked = set()
    # "12 - 15" should read the same as "12-15".
    text = re.sub(r"\s*-\s*", "-", text.strip())
    for token in re.split(r"[\s,]+", text):
        if not token:
            continue
        match = re.fullmatch(r"(\d+)(?:\s*-\s*(\d+))?", token)
        if not match:
            print(f"  '{token}' is not a number or range.")
            return None
        low = int(match.group(1))
        high = int(match.group(2) or low)
        if low < 1 or high > count or low > high:
            print(f"  '{token}' is outside 1-{count}.")
            return None
        picked.update(range(low, high + 1))
    return picked


def ask_numbers(question, count):
    """Ask for a set of list numbers, re-asking until the answer parses."""
    while True:
        print(question)
        print(f'    numbers from the list above — "3 7 12-15" or "3,7,12-15" '
              f'(1-{count}); blank = none')
        try:
            text = input("  > ").strip()
        except EOFError:
            return set()
        if not text:
            return set()
        picked = parse_selection(text, count)
        if picked is not None:
            return picked


def fmt_ts(dt):
    if dt is None:
        return "unknown date"
    return dt.astimezone().strftime("%Y-%m-%d %H:%M")


def choose_sessions(sessions, quiet=False):
    """The y/n + numbered-exclusion wizard. Returns the sessions to export."""
    by_project = defaultdict(list)
    for sess in sessions:
        by_project[sess.project].append(sess)
    projects = sorted(by_project, key=lambda p: (-len(by_project[p]), p))

    width = len(str(len(projects)))
    print(f"\n{len(projects)} project(s) with sessions in the window:\n")
    for index, project in enumerate(projects, 1):
        group = by_project[project]
        agents = ", ".join(f"{LABELS[a]} {n}" for a, n in
                           sorted(_count_by(group, lambda s: s.agent).items()))
        print(f"  [{index:>{width}}]  {project}")
        scripted = [s.scripted for s in group if s.scripted]
        print(f"   {'':>{width}}   {len(group)} session(s)"
              f"{f' ({len(scripted)} {sorted(set(scripted))[0]})' if scripted else ''}, "
              f"{sum(s.user_messages for s in group)} user message(s), "
              f"{human_bytes(sum(s.size for s in group))} — {agents}")

    if ask_yes_no(f"\nExport all {len(projects)} project(s)?", default=True):
        return list(sessions)

    picked = ask_numbers(
        "\nWhich projects should NOT be exported in full? Each one you pick "
        "is\n  then listed session by session, so you can keep some of it.",
        len(projects))
    if not picked:
        print("  nothing picked — exporting all projects.")
        return list(sessions)

    print(f"\n  Picked {len(picked)} project(s) to go through:")
    for number in sorted(picked):
        print(f"    [{number}] {projects[number - 1]}")

    keep, position = [], 0
    for index, project in enumerate(projects, 1):
        if index not in picked:
            keep += by_project[project]
            continue
        position += 1
        keep += _choose_within_project(project, by_project[project],
                                       index, position, len(picked))
    return keep


def _choose_within_project(project, sessions, number, position, total):
    ordered = sorted(sessions, key=lambda s: (s.started or datetime.max.replace(
        tzinfo=timezone.utc), s.session_id))
    print(f"\n  ─── project [{number}] — {position} of {total} to go through "
          f"───")
    print(f"      {project}")
    print(f"      {len(ordered)} session(s):\n")
    width = len(str(len(ordered)))
    for index, sess in enumerate(ordered, 1):
        span = None
        if sess.started and sess.ended:
            span = (sess.ended - sess.started).total_seconds()
        preview = f'"{sess.preview}"' if sess.preview else "(no typed prompt)"
        label = LABELS[sess.agent] + (f" — {sess.scripted}" if sess.scripted else "")
        print(f"    {index:>{width}}  {fmt_ts(sess.started)}  "
              f"{human_duration(span):>7}  {sess.user_messages:>3} msg  "
              f"{human_bytes(sess.size):>10}  {label}")
        print(f"    {'':>{width}}  {preview}")

    if ask_yes_no(f"\n  Exclude ALL {len(ordered)} session(s) of project "
                  f"[{number}]?", default=True):
        print(f"  -> excluding all {len(ordered)} session(s) of [{number}]")
        return []
    drop = ask_numbers(f"  Which sessions of project [{number}] should be "
                       f"excluded?", len(ordered))
    kept = [s for i, s in enumerate(ordered, 1) if i not in drop]
    print(f"  -> keeping {len(kept)} of {len(ordered)} session(s) "
          f"of [{number}]")
    return kept


def _count_by(items, key):
    counts = defaultdict(int)
    for item in items:
        counts[key(item)] += 1
    return counts


