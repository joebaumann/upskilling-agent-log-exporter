class Artifact:
    """One file destined for the zip: either on disk, or synthesized in memory."""

    __slots__ = ("kind", "arc", "path", "data", "size")

    def __init__(self, kind, arc, path=None, data=None):
        self.kind = kind
        self.arc = arc
        self.path = path
        self.data = data
        if data is not None:
            self.size = len(data)
        else:
            try:
                self.size = path.stat().st_size
            except OSError:
                self.size = 0


class Session:
    """One agent session, plus every file that belongs to it."""

    __slots__ = ("agent", "session_id", "project", "started", "ended",
                 "records", "preview", "artifacts", "group", "ts_from_mtime",
                 "user_messages", "entrypoint")

    def __init__(self, agent, session_id, project, started, ended,
                 records, preview, group, ts_from_mtime=False,
                 user_messages=0, entrypoint=None):
        self.agent = agent
        self.session_id = session_id
        self.project = project or "(unknown project)"
        self.started = started
        self.ended = ended or started
        self.records = records
        self.preview = preview
        self.artifacts = []
        self.group = group           # extras of this group ride along
        self.ts_from_mtime = ts_from_mtime
        self.user_messages = user_messages
        self.entrypoint = entrypoint

    @property
    def scripted(self):
        """The entrypoint that ran this session, when it was not a keyboard."""
        return self.entrypoint if (self.entrypoint or "").startswith(
            SCRIPTED_ENTRYPOINTS) else None

    @property
    def size(self):
        return sum(a.size for a in self.artifacts)

    def kept_artifacts(self, kinds):
        return [a for a in self.artifacts if a.kind in kinds]


def _mtime(path):
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    except OSError:
        return None


def _session_from_peek(agent, path, arc, group, session_id=None, project=None):
    info = peek_transcript(path)
    times = info["times"]
    from_mtime = not times
    started = min(times) if times else _mtime(path)
    ended = max(times) if times else started
    sess = Session(agent, session_id or info["sid"] or path.stem,
                   project or info["cwd"], started, ended,
                   info["records"], info["preview"], group, from_mtime,
                   info["user_messages"], info["entrypoint"])
    sess.artifacts.append(Artifact("session", arc, path=path))
    return sess


