def resolve_agents(values):
    """--agents claude,codex / --agents claude codex -> canonical keys."""
    if not values:
        return None
    out = []
    for value in values:
        for token in re.split(r"[\s,]+", value):
            token = token.strip().lower()
            if not token:
                continue
            if token == "all":
                return list(AGENT_KEYS)
            key = ALIASES.get(token, token)
            if key not in LABELS:
                raise SystemExit(
                    f"agent-logs: unknown agent {token!r}. "
                    f"Choose from: {', '.join(AGENT_KEYS)}")
            if key not in out:
                out.append(key)
    return out


def build_parser():
    parser = argparse.ArgumentParser(
        prog="agent-logs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Bundle local coding-agent session logs into a shareable zip.",
        epilog="agents: " + ", ".join(f"{k} ({LABELS[k]})" for k in AGENT_KEYS))
    parser.add_argument("--start-date", default="31d", metavar="DATE",
                        help="earliest day to include: YYYY-MM-DD, Nd (the "
                             "last N days, today included) or all "
                             "(default: 31d)")
    parser.add_argument("--end-date", default=None, metavar="DATE",
                        help="latest day to include, inclusive (default: today)")
    parser.add_argument("--agents", nargs="+", metavar="AGENT",
                        help="agents to export (default: every one found)")
    parser.add_argument("-o", "--output", metavar="PATH",
                        help="zip file, or a directory to put it in "
                             "(default: ./agent-logs-<timestamp>.zip)")
    for key in AGENT_KEYS:
        parser.add_argument(f"--{key}-path", metavar="DIR", action="append",
                            help=argparse.SUPPRESS)
    parser.add_argument("--no-subagents", action="store_true",
                        help="omit subagent transcripts")
    parser.add_argument("--no-metadata", action="store_true",
                        help="omit sidecar metadata (*.meta.json, session indexes)")
    parser.add_argument("--no-tool-results", action="store_true",
                        help="omit stored tool output files")
    parser.add_argument("--no-images", action="store_true",
                        help="omit images and PDF page renders")
    parser.add_argument("--no-memory", action="store_true",
                        help="omit per-project agent memory files")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="no questions: export everything in the window")
    parser.add_argument("--dry-run", action="store_true",
                        help="show what would be exported, write nothing")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="only print the final summary")
    parser.add_argument("--version", action="version", version=f"agent-logs {VERSION}")
    return parser


def selected_kinds(args):
    kinds = set(KINDS)
    for flag, kind in (("no_subagents", "subagent"), ("no_metadata", "metadata"),
                       ("no_tool_results", "tool-result"), ("no_images", "image"),
                       ("no_memory", "memory")):
        if getattr(args, flag):
            kinds.discard(kind)
    return kinds


def resolve_output(value):
    """A zip path from --output: a file, a directory to fill, or nothing."""
    default = f"agent-logs-{datetime.now().strftime('%Y%m%d-%H%M%S')}.zip"
    if not value:
        return Path.cwd() / default
    path = Path(value).expanduser()
    if path.is_dir() or str(value).endswith(("/", os.sep)):
        return path / default
    return path if path.suffix.lower() == ".zip" else path.with_suffix(".zip")


def main(argv=None):
    args = build_parser().parse_args(argv)
    quiet = args.quiet
    defaulted_window = ("--start-date" not in (argv or sys.argv[1:])
                        and "--end-date" not in (argv or sys.argv[1:]))
    start_date = parse_date_arg(args.start_date, "--start-date")
    end_date = parse_date_arg(args.end_date, "--end-date") or date.today()
    if start_date and start_date > end_date:
        raise SystemExit("agent-logs: --start-date is after --end-date")
    start, end = local_window(start_date, end_date)
    kinds = selected_kinds(args)

    # 1. Where to look for each agent.
    requested = resolve_agents(args.agents)
    if not quiet:
        print(describe_window(start_date, end_date, defaulted_window),
              file=sys.stderr)

    # 2. Scan. Every agent on the machine is looked at, so the questions below
    #    can quote real numbers and so a wrong --<agent>-path can fall back.
    found_by_agent, all_extras, sources = {}, {}, {}
    for key in AGENT_KEYS:
        override = getattr(args, f"{key}_path")
        paths = [Path(p).expanduser() for p in override] if override \
            else default_roots(key)
        kind = "override" if override else "default"
        found, extras = scan_agent(key, paths)

        # Missing logs are the worst outcome here, so an override that turns up
        # nothing is treated as a mistake rather than as an instruction: fall
        # back to the standard location, and say so.
        if not found and kind == "override":
            fallback = default_roots(key)
            alt, alt_extras = scan_agent(key, fallback)
            if alt:
                print(f"note: --{key}-path found no sessions in "
                      f"{', '.join(str(p) for p in paths)}; using the default "
                      f"location instead", file=sys.stderr)
                paths, kind, found, extras = fallback, "fallback", alt, alt_extras

        if not found and not any(p.exists() for p in paths):
            continue                       # this agent is not on this machine
        sources[key] = {"roots": [str(p) for p in paths if p.exists()],
                        "root_source": kind, "found": len(found)}
        all_extras.update(extras)
        found_by_agent[key] = [s for s in found if in_window(s, start, end)]

    present = list(found_by_agent)
    if not present:
        raise SystemExit("agent-logs: no agent logs found on this machine.")
    for key in (requested or []):
        if key not in present:
            print(f"note: no logs found for {LABELS[key]}", file=sys.stderr)

    if not quiet:
        for key in present:
            where = "" if sources[key]["root_source"] == "default" \
                else f"  [--{key}-path]" if sources[key]["root_source"] == "override" \
                else "  [default, after --%s-path was empty]" % key
            print(f"  {LABELS[key]:<18} {len(found_by_agent[key]):>4} session(s) "
                  f"in window (of {sources[key]['found']} found), "
                  f"{sum(s.user_messages for s in found_by_agent[key])} "
                  f"user message(s){where}", file=sys.stderr)

    # 3. Confirm the agent list: anything found but not asked for is offered.
    chosen = [k for k in (requested or present) if k in present]
    if requested is not None:
        others = [k for k in present if k not in chosen and found_by_agent[k]]
        if others and not args.yes:
            print()
            for key in others:
                count = len(found_by_agent[key])
                if ask_yes_no(f"{LABELS[key]} also has {count} session(s) in this "
                              f"window and was not selected. Include it?",
                              default=False):
                    chosen.append(key)
        elif others:
            print("note: found but not selected: "
                  + ", ".join(LABELS[k] for k in others), file=sys.stderr)

    for key in present:
        sources[key]["in_window"] = len(found_by_agent[key])
        sources[key]["selected"] = len(found_by_agent[key]) if key in chosen else 0
    all_sessions = [s for k in sorted(chosen, key=AGENT_KEYS.index)
                    for s in found_by_agent[k]]
    if not all_sessions:
        raise SystemExit("agent-logs: no sessions in the selected window.")

    # 3. Narrow down interactively.
    before = len(all_sessions)
    projects_before = len({s.project for s in all_sessions})
    if args.yes:
        keep = all_sessions
    else:
        keep = choose_sessions(all_sessions)
    if not keep:
        raise SystemExit("agent-logs: everything was excluded, nothing to write.")

    window = {
        "start_date": start_date, "end_date": end_date,
        "excluded_projects": projects_before - len({s.project for s in keep}),
        "excluded_sessions": before - len(keep),
    }

    # 4. Write.
    out_path = resolve_output(args.output)
    groups = {s.group for s in keep}
    artifacts = [a for s in keep for a in s.kept_artifacts(kinds)]
    artifacts += [a for group, items in all_extras.items() if group in groups
                  for a in items if a.kind in kinds]
    kept_bytes = sum(a.size for a in artifacts)
    print(f"\n{len(keep)} session(s) from "
          f"{len({s.project for s in keep})} project(s), "
          f"{sum(s.user_messages for s in keep)} user message(s): "
          f"{len(artifacts)} file(s), {human_bytes(kept_bytes)} uncompressed.")
    if args.dry_run:
        print(f"Dry run — would write {out_path}")
        return 0
    if not args.yes and not ask_yes_no(f"Write {out_path}?", default=True):
        print("Nothing written.")
        return 1

    try:
        stats, manifest, skipped = write_zip(out_path, keep, all_extras, kinds,
                                             window, quiet, sources)
    except BaseException:                       # including Ctrl-C mid-write
        partial = out_path.with_name(out_path.name + ".part")
        if partial.exists():
            partial.unlink()
        raise
    size = out_path.stat().st_size
    ratio = f", {100 * size / kept_bytes:.0f}% of {human_bytes(kept_bytes)}" \
        if kept_bytes else ""
    print(f"\nWrote {out_path}  ({human_bytes(size)}{ratio})")
    for label, count in stats["sessions_per_agent"].items():
        print(f"  {label:<20} {count:>5} session(s), "
              f"{stats['user_messages_per_agent'][label]:>5} user message(s)")
    if skipped:
        print(f"  {len(skipped)} file(s) could not be read and were skipped "
              f"(listed in manifest.json)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nInterrupted.", file=sys.stderr)
        sys.exit(130)
