def _iter_files(root):
    """Every regular file under root. Symlinks are not followed."""
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = [d for d in dirnames
                       if not (Path(dirpath) / d).is_symlink()]
        for name in sorted(filenames):
            path = Path(dirpath) / name
            if name in IGNORED_NAMES or path.is_symlink():
                continue
            if not path.is_file():        # sockets, FIFOs — ~/.cursor has one
                continue
            yield path


def _kind_for(path):
    if path.suffix.lower() in IMAGE_SUFFIXES:
        return "image"
    if path.name.endswith(".meta.json"):
        return "metadata"
    return "tool-result"


def scan_claude(root, arc_prefix):
    """Claude Code: <slug>/<session>.jsonl plus per-session artifact folders.

    A project folder also holds files that belong to no single session
    (memory/, sessions-index.json); they ride along with their project.
    """
    sessions, extras = [], defaultdict(list)
    if not root.is_dir():
        return sessions, extras
    for slug_dir in sorted(p for p in root.iterdir() if p.is_dir()):
        if slug_dir.is_symlink():
            continue
        group = f"claude:{slug_dir.name}"
        by_id, in_slug = {}, []
        for path in sorted(slug_dir.glob("*.jsonl")):
            arc = f"{arc_prefix}/{slug_dir.name}/{path.name}"
            sess = _session_from_peek("claude", path, arc, group)
            by_id[path.stem] = sess
            in_slug.append(sess)
            sessions.append(sess)
        # A session with no cwd of its own (a title-only stub left by /fork, or
        # a renamed session) still belongs to this folder's project.
        fallback = _majority_cwd(in_slug) or str(slug_dir)
        for sess in in_slug:
            if sess.project == "(unknown project)":
                sess.project = fallback
        for child in sorted(slug_dir.iterdir()):
            if child.is_symlink():
                continue
            if child.is_dir() and child.name in by_id:          # session sidecar dir
                host = by_id[child.name]
                for path in _iter_files(child):
                    rel = path.relative_to(slug_dir).as_posix()
                    kind = "subagent" if (path.suffix == ".jsonl"
                                          and "subagents" in path.parts) \
                        else _kind_for(path)
                    host.artifacts.append(
                        Artifact(kind, f"{arc_prefix}/{slug_dir.name}/{rel}", path=path))
            elif child.is_dir():                                # memory/, orphan dirs
                for path in _iter_files(child):
                    rel = path.relative_to(slug_dir).as_posix()
                    kind = "memory" if child.name == "memory" else _kind_for(path)
                    extras[group].append(
                        Artifact(kind, f"{arc_prefix}/{slug_dir.name}/{rel}", path=path))
            elif child.suffix != ".jsonl" and child.name not in IGNORED_NAMES:
                extras[group].append(
                    Artifact("metadata", f"{arc_prefix}/{slug_dir.name}/{child.name}",
                             path=child))
    return sessions, extras


def _majority_cwd(sessions):
    counts = _count_by([s for s in sessions if s.project != "(unknown project)"],
                       lambda s: s.project)
    return max(counts, key=counts.get) if counts else None


def scan_files(agent, root, arc_prefix):
    """Generic file-based agent: one transcript file is one session."""
    sessions = []
    for path in _iter_files(root):
        if path.suffix.lower() not in TRANSCRIPT_SUFFIXES:
            continue
        try:
            rel = path.relative_to(root).as_posix()
        except ValueError:
            rel = path.name
        sessions.append(_session_from_peek(
            agent, path, f"{arc_prefix}/{rel}", f"{agent}:{root}"))
    return sessions, {}


# --------------------------------------------------------------------------- #
# SQLite-backed agents: rows are exported to files inside the zip
# --------------------------------------------------------------------------- #

def _open_ro(db_path):
    """Open a SQLite file read-only, on a private copy of any hot WAL."""
    import sqlite3
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        con.execute("select 1")
        return con
    except Exception:
        return None


def scan_opencode(root, arc_prefix):
    """OpenCode keeps sessions in opencode.db; export one bundle per session.

    The bundle shape ({info, messages:[{info, parts}]}) is the same one
    OpenCode itself exports, so the parser reads it with no special case.
    """
    dbs = [p for p in sorted(root.glob("*.db")) if p.is_file()]
    sessions = []
    for db in dbs:
        con = _open_ro(db)
        if con is None:
            continue
        try:
            rows = con.execute(
                "SELECT id, directory, title, time_created, time_updated, "
                "       slug, parent_id, project_id, agent, model, version "
                "FROM session").fetchall()
        except Exception:
            con.close()
            continue
        cols = ("id", "directory", "title", "time_created", "time_updated",
                "slug", "parent_id", "project_id", "agent", "model", "version")
        infos = {r[0]: dict(zip(cols, r)) for r in rows}
        try:
            msg_rows = con.execute(
                "SELECT id, session_id, time_created, time_updated, data "
                "FROM message ORDER BY session_id, time_created, id").fetchall()
            part_rows = con.execute(
                "SELECT message_id, id, time_created, data "
                "FROM part ORDER BY message_id, time_created, id").fetchall()
        except Exception:
            con.close()
            continue
        con.close()

        parts_by_msg = defaultdict(list)
        for message_id, part_id, created, data in part_rows:
            parts_by_msg[message_id].append(
                _json_or_raw(data, {"id": part_id, "time_created": created}))

        msgs_by_session = defaultdict(list)
        for mid, sid, created, updated, data in msg_rows:
            info = _json_or_raw(data, {"id": mid, "time_created": created,
                                       "time_updated": updated})
            msgs_by_session[sid].append({"info": info, "parts": parts_by_msg.get(mid, [])})

        stem = db.stem
        for sid, info in infos.items():
            messages = msgs_by_session.get(sid, [])
            if not messages:
                continue
            bundle = {
                "info": {
                    "id": sid,
                    "directory": info.get("directory"),
                    "title": info.get("title"),
                    "slug": info.get("slug"),
                    "parentID": info.get("parent_id"),
                    "projectID": info.get("project_id"),
                    "agent": info.get("agent"),
                    "model": info.get("model"),
                    "version": info.get("version"),
                    "time": {"created": info.get("time_created"),
                             "updated": info.get("time_updated")},
                },
                "messages": messages,
            }
            data = json.dumps(bundle, ensure_ascii=False).encode("utf-8")
            arc = f"{arc_prefix}/{stem}/{sid}.json"
            times = [t for t in (normalize_ts(info.get("time_created")),
                                 normalize_ts(info.get("time_updated"))) if t]
            typed = []
            for m in messages:
                ts = normalize_ts((m["info"] or {}).get("time_created"))
                if ts:
                    times.append(ts)
                if (m["info"] or {}).get("role") == "user":
                    typed += [(part.get("text"), "typed")
                              for part in m.get("parts") or []
                              if isinstance(part, dict) and part.get("type") == "text"
                              and not part.get("synthetic")]
            preview = _opencode_preview(messages)
            sess = Session("opencode", sid, info.get("directory"),
                           min(times) if times else None,
                           max(times) if times else None,
                           len(messages), preview, f"opencode:{db}",
                           user_messages=count_user_messages(typed))
            sess.artifacts.append(Artifact("session", arc, data=data))
            sessions.append(sess)
    return sessions, {}


def _json_or_raw(data, extra):
    try:
        obj = json.loads(data) if isinstance(data, str) else data
    except (json.JSONDecodeError, ValueError, TypeError):
        obj = {"raw": data}
    if not isinstance(obj, dict):
        obj = {"raw": obj}
    for key, val in extra.items():
        obj.setdefault(key, val)
    return obj


def _opencode_preview(messages):
    for m in messages:
        if (m.get("info") or {}).get("role") != "user":
            continue
        for part in m.get("parts") or []:
            if isinstance(part, dict) and part.get("type") == "text" \
                    and part.get("text") and not part.get("synthetic"):
                return " ".join(part["text"].split())[:70]
    return None


def scan_cursor(root, arc_prefix):
    """Dispatch on which of Cursor's two layouts this root is."""
    if (root / "globalStorage").is_dir() or (root / "workspaceStorage").is_dir():
        return _scan_cursor_ide(root, arc_prefix)
    return _scan_cursor_cli(root, arc_prefix)


def _scan_cursor_cli(root, arc_prefix):
    """cursor-agent: <root>/<slug>/agent-transcripts/<id>/<id>.jsonl.

    The transcript itself carries no timestamps and only a mangled project
    slug, but a sidecar under ~/.cursor/chats/<hash>/<id>/ has the exact cwd
    and the created/updated times. Those sidecars travel with the session so
    nothing about it is guessed later.
    """
    sidecars = {}
    chats = root.parent / "chats"
    if chats.is_dir():
        for meta in chats.glob("*/*/meta.json"):
            sidecars[meta.parent.name] = meta.parent

    sessions = []
    for transcript in sorted(root.glob("*/agent-transcripts/*/*.jsonl")):
        slug = transcript.relative_to(root).parts[0]
        session_id = transcript.parent.name
        rel = transcript.relative_to(root).as_posix()
        sess = _session_from_peek("cursor", transcript, f"{arc_prefix}/{rel}",
                                  f"cursor:{slug}", session_id=session_id)

        side = sidecars.get(session_id)
        if side is not None:
            meta = {}
            try:
                meta = json.loads((side / "meta.json").read_text(
                    encoding="utf-8", errors="replace")) or {}
            except (OSError, json.JSONDecodeError, ValueError):
                meta = {}
            if meta.get("cwd"):
                sess.project = meta["cwd"]
            created = normalize_ts(meta.get("createdAtMs"))
            updated = normalize_ts(meta.get("updatedAtMs"))
            if created:
                sess.started, sess.ended = created, updated or created
                sess.ts_from_mtime = False
            # meta.json, prompt_history.json and the blob store are the rest of
            # what Cursor kept about this session; keep them beside it.
            for extra in sorted(_iter_files(side)):
                sess.artifacts.append(Artifact(
                    "metadata",
                    f"{arc_prefix}/{transcript.parent.relative_to(root).as_posix()}"
                    f"/cursor-chat/{extra.name}", path=extra))
        if sess.project == "(unknown project)":
            sess.project = str(root / slug)
        sessions.append(sess)
    return sessions, {}


def _scan_cursor_ide(root, arc_prefix):
    """Cursor IDE stores chats in state.vscdb; export one JSONL per composer.

    Best effort: Cursor's schema is undocumented and has changed several times.
    Rows that do not match a known shape are still written out verbatim, so
    nothing is silently lost.
    """
    sessions = []
    global_db = root / "globalStorage" / "state.vscdb"
    folders = {}                                     # composerId -> workspace folder
    ws_root = root / "workspaceStorage"
    if ws_root.is_dir():
        for ws_dir in sorted(p for p in ws_root.iterdir() if p.is_dir()):
            folder = None
            meta = ws_dir / "workspace.json"
            if meta.is_file():
                try:
                    raw = json.loads(meta.read_text(encoding="utf-8", errors="replace"))
                    uri = raw.get("folder") or raw.get("workspace")
                    folder = _uri_to_path(uri) if isinstance(uri, str) else None
                except (OSError, json.JSONDecodeError, ValueError):
                    folder = None
            db = ws_dir / "state.vscdb"
            if not db.is_file():
                continue
            con = _open_ro(db)
            if con is None:
                continue
            try:
                for key, value in con.execute(
                        "SELECT key, value FROM ItemTable WHERE key LIKE '%omposer%' "
                        "OR key LIKE '%aichat%' OR key LIKE '%chatdata%'"):
                    for cid in _cursor_composer_ids(value):
                        folders[cid] = folder
                    sess = _cursor_workspace_session(
                        key, value, folder, ws_dir.name, arc_prefix)
                    if sess:
                        sessions.append(sess)
            except Exception:
                pass
            con.close()

    if global_db.is_file():
        sessions += _cursor_global_sessions(global_db, folders, arc_prefix)
    return sessions, {}


def _cursor_composer_ids(value):
    try:
        obj = json.loads(value) if isinstance(value, (str, bytes)) else None
    except (json.JSONDecodeError, ValueError):
        return []
    ids = []
    if isinstance(obj, dict):
        for entry in obj.get("allComposers") or []:
            if isinstance(entry, dict) and isinstance(entry.get("composerId"), str):
                ids.append(entry["composerId"])
    return ids


def _cursor_workspace_session(key, value, folder, ws_name, arc_prefix):
    """Legacy in-workspace chat blobs (workbench.panel.aichat.…chatdata)."""
    if "chatdata" not in key.lower():
        return None
    try:
        obj = json.loads(value) if isinstance(value, (str, bytes)) else None
    except (json.JSONDecodeError, ValueError):
        return None
    tabs = (obj or {}).get("tabs") if isinstance(obj, dict) else None
    if not isinstance(tabs, list) or not tabs:
        return None
    lines, count, preview, typed = [], 0, None, []
    header = {"cursor_session": {"source": key, "workspace": ws_name,
                                 "directory": folder}}
    lines.append(json.dumps(header, ensure_ascii=False))
    for tab in tabs:
        if not isinstance(tab, dict):
            continue
        for bubble in tab.get("bubbles") or []:
            if not isinstance(bubble, dict):
                continue
            role = "user" if bubble.get("type") == "user" else "assistant"
            text = bubble.get("text") or bubble.get("rawText") or ""
            lines.append(json.dumps({"role": role, "message": text,
                                     "cursor_raw": bubble}, ensure_ascii=False))
            count += 1
            if role == "user":
                typed.append((text, "typed"))
            if role == "user" and preview is None and text.strip():
                preview = " ".join(text.split())[:70]
    if count == 0:
        return None
    data = ("\n".join(lines) + "\n").encode("utf-8")
    arc = f"{arc_prefix}/workspace-{ws_name}/chatdata.jsonl"
    # These bubbles carry no timestamps at all, so the session is undateable;
    # in_window() keeps it rather than dropping it on a guess.
    sess = Session("cursor", f"{ws_name}-chatdata", folder, None, None,
                   count, preview, f"cursor:{ws_name}",
                   user_messages=count_user_messages(typed))
    sess.artifacts.append(Artifact("session", arc, data=data))
    return sess


def _cursor_global_sessions(db_path, folders, arc_prefix):
    """globalStorage: composerData:<id> headers plus bubbleId:<id>:<n> messages."""
    con = _open_ro(db_path)
    if con is None:
        return []
    try:
        rows = con.execute(
            "SELECT key, value FROM cursorDiskKV "
            "WHERE key LIKE 'composerData:%' OR key LIKE 'bubbleId:%'").fetchall()
    except Exception:
        con.close()
        return []
    con.close()

    headers, bubbles = {}, defaultdict(list)
    for key, value in rows:
        try:
            obj = json.loads(value) if isinstance(value, (str, bytes)) else None
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(obj, dict):
            continue
        if key.startswith("composerData:"):
            headers[key.split(":", 1)[1]] = obj
        else:
            parts = key.split(":")
            if len(parts) >= 3:
                bubbles[parts[1]].append((parts[2], obj))

    sessions = []
    for cid, header in headers.items():
        order = [h.get("bubbleId") for h in header.get("fullConversationHeadersOnly") or []
                 if isinstance(h, dict)]
        found = dict(bubbles.get(cid, []))
        ordered = [(bid, found[bid]) for bid in order if bid in found]
        ordered += [(bid, obj) for bid, obj in sorted(bubbles.get(cid, []))
                    if bid not in set(order)]
        # conversationMap is the older inline form of the same messages.
        inline = header.get("conversationMap")
        if not ordered and isinstance(inline, dict):
            ordered = sorted(inline.items())
        if not ordered:
            continue

        folder = folders.get(cid)
        lines = [json.dumps({"cursor_session": {
            "composerId": cid, "directory": folder,
            "name": header.get("name"), "createdAt": header.get("createdAt"),
            "lastUpdatedAt": header.get("lastUpdatedAt")}}, ensure_ascii=False)]
        times = [t for t in (normalize_ts(header.get("createdAt")),
                             normalize_ts(header.get("lastUpdatedAt"))) if t]
        preview, count, typed = None, 0, []
        for _bid, bubble in ordered:
            if not isinstance(bubble, dict):
                continue
            role = "user" if bubble.get("type") == 1 or bubble.get("role") == "user" \
                else "assistant"
            text = bubble.get("text") or bubble.get("richText") or ""
            if not isinstance(text, str):
                text = json.dumps(text, ensure_ascii=False)
            lines.append(json.dumps({"role": role, "message": text,
                                     "cursor_raw": bubble}, ensure_ascii=False))
            count += 1
            if role == "user":
                typed.append((text, "typed"))
            if role == "user" and preview is None and text.strip():
                preview = " ".join(text.split())[:70]
        data = ("\n".join(lines) + "\n").encode("utf-8")
        sess = Session("cursor", cid, folder,
                       min(times) if times else None,
                       max(times) if times else None,
                       count, preview, f"cursor:{db_path}",
                       user_messages=count_user_messages(typed))
        sess.artifacts.append(Artifact("session", f"{arc_prefix}/{cid}.jsonl", data=data))
        sessions.append(sess)
    return sessions


SCANNERS = {
    "claude": scan_claude,
    "opencode": scan_opencode,
    "cursor": scan_cursor,
}


def scan_agent(agent, roots):
    """Scan every existing root for one agent, de-duplicating arcnames."""
    sessions, extras = [], {}
    live = [r for r in roots if r.exists()]
    for index, root in enumerate(live):
        prefix = f"logs/{agent}" if len(live) == 1 else f"logs/{agent}/root{index + 1}"
        scanner = SCANNERS.get(agent)
        try:
            # Agents with their own scanner take (root, prefix); everything
            # else goes through the generic one, which also needs the key.
            found, found_extras = (scanner(root, prefix) if scanner
                                   else scan_files(agent, root, prefix))
        except OSError as exc:
            print(f"  ! {LABELS[agent]}: cannot read {root} ({exc})", file=sys.stderr)
            continue
        sessions += found
        extras.update(found_extras)
    return sessions, extras


