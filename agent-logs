def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:,.1f} {unit}"
        n /= 1024.0


def human_duration(seconds):
    """First-to-last-activity span. A resumed session can span days."""
    if seconds is None or seconds < 0:
        return "-"
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    d, h = divmod(h, 24)
    if d:
        return f"{d}d{h:02d}h"
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def normalize_ts(value):
    """A datetime (UTC) from an ISO string or an epoch in s/ms/us/ns."""
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        v = float(value)
        if v <= 0:
            return None
        for scale in (1.0, 1e3, 1e6, 1e9):          # s, ms, us, ns
            t = v / scale
            if 1e9 < t < 4e9:                        # 2001-2096, sane range
                try:
                    return datetime.fromtimestamp(t, tz=timezone.utc)
                except (OverflowError, OSError, ValueError):
                    return None
        return None
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        if text.isdigit():
            return normalize_ts(int(text))
        try:
            dt = datetime.fromisoformat(text.replace("Z", "+00:00"))
        except ValueError:
            return None
        # A bare timestamp with no zone is read as UTC: agents that write ISO
        # strings write them in UTC, and guessing local time would shift days.
        return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None \
            else dt.astimezone(timezone.utc)
    return None


TS_KEYS = ("timestamp", "time_created", "createdAt", "created_at", "created",
           "startTime", "start_time", "time", "ts", "date", "updatedAt",
           "time_updated", "lastUpdated", "endTime")
CWD_KEYS = ("cwd", "directory", "workspacePath", "workspace_path", "projectPath",
            "project_path", "workingDirectory", "working_directory", "worktree",
            "folder", "root", "workspaceRoot")
SID_KEYS = ("sessionId", "session_id", "sessionID", "conversationId", "id")
NESTED_KEYS = ("payload", "info", "message", "session", "data", "meta",
               "turn_context", "state")

# role: user records the harness wrote rather than the human. Only used to pick
# a preview line for the exclusion menu, so a rough list is enough.
INJECTED_PREFIXES = (
    "<command-name>", "<command-message>", "<command-args>", "<local-command",
    "<system-reminder>", "<system_instruction", "<task-notification>",
    "<teammate-message", "<bash-input>", "<bash-stdout>", "<bash-stderr>",
    "<user-prompt-submit-hook>", "<ide_", "<environment_context>",
    "<user_instructions>", "Caveat:", "This session is being continued",
    "Base directory for this skill:", "[Request interrupted",
)

# entrypoint sdk-cli / sdk-ts / sdk-py: the prompt came from a program.
SCRIPTED_ENTRYPOINTS = ("sdk",)

# Harness wrappers around typed text: the block goes, the prose around it stays.
INJECTED_BLOCK_RE = re.compile(
    r"(?s)<(system-reminder|local-command-[a-z]+|command-name|command-message"
    r"|command-args|ide_[a-z_]*|timestamp)\b[^>]*>.*?</\1>|</?user_query>")


def _scan_record(rec, found):
    """Harvest timestamps / cwd / session id from one record, in place."""
    if not isinstance(rec, dict):
        return
    for key in TS_KEYS:
        if key in rec:
            ts = normalize_ts(rec[key])
            if ts:
                found["times"].append(ts)
                break
    for key in CWD_KEYS:
        val = rec.get(key)
        if isinstance(val, str) and val and not found["cwd"]:
            if key == "folder" and val.startswith(("file://", "vscode-remote://")):
                val = _uri_to_path(val)
            if val not in ("/", ".", ""):
                found["cwd"] = val
                break
    if not found["sid"]:
        for key in SID_KEYS:
            val = rec.get(key)
            if isinstance(val, str) and 8 <= len(val) <= 128:
                found["sid"] = val
                break


def _uri_to_path(uri):
    """file:///a/b -> /a/b; remote URIs keep their host so they stay distinct."""
    from urllib.parse import unquote, urlparse
    parsed = urlparse(uri)
    path = unquote(parsed.path)
    if parsed.scheme == "file":
        # Windows: file:///C:/x -> C:/x
        return path[1:] if re.match(r"^/[A-Za-z]:", path) else path
    return f"{parsed.scheme}://{parsed.netloc}{path}"


def _record_text(rec):
    """Plain text of a record's user-facing content, or ''."""
    msg = rec.get("message") if isinstance(rec.get("message"), (dict, str)) else None
    content = None
    if isinstance(msg, str):
        content = msg
    elif isinstance(msg, dict):
        content = msg.get("content")
    if content is None:
        content = rec.get("content") or rec.get("text") or rec.get("prompt")
    if isinstance(content, str):
        return content
    out = []
    if isinstance(content, list):
        for block in content:
            if isinstance(block, str):
                out.append(block)
            elif isinstance(block, dict) and isinstance(block.get("text"), str):
                out.append(block["text"])
    text = "\n".join(out)
    if not text:
        for key in ("payload", "data"):
            nested = rec.get(key)
            if isinstance(nested, dict):
                text = _record_text(nested)
                if text:
                    break
    return text


def _user_record_kind(rec):
    """None, "typed", or "echo" — an echo is a second copy of a typed message."""
    if rec.get("isMeta") or rec.get("isSidechain"):
        return None
    role = rec.get("role")
    for key in ("message", "payload", "data"):
        nested = rec.get(key)
        if not role and isinstance(nested, dict):
            role = nested.get("role")
    rtype = rec.get("type") or ""
    payload = rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
    if rtype.startswith("queue") or (rtype == "response_item" and role == "user"):
        return "echo"
    if role == "user" or payload.get("type") == "user_message" \
            or rtype in ("user", "user.message", "user_message"):
        return "typed"
    return None


def count_user_messages(candidates):
    """Messages the human typed, from (text, kind) pairs: no injections, no
    slash commands, no second copies — but the same text typed twice counts."""
    typed, echoes = [], set()
    for raw, kind in candidates:
        if not isinstance(raw, str):
            continue
        text = " ".join(INJECTED_BLOCK_RE.sub("", raw).split())
        if not text or text.startswith("/") or text.startswith(INJECTED_PREFIXES):
            continue
        if kind == "echo":
            echoes.add(text)
        else:
            typed.append(text)
    duplicated = {e for e in echoes
                  for t in typed if e == t or (len(t) >= 20 and t in e)}
    return len(typed) + len(echoes - duplicated)


MESSAGE_TYPES = {"user", "assistant", "message", "response_item", "user.message",
                 "assistant.message", "user_message", "agent_message",
                 "assistant.turn_start", "tool.execution_complete"}


def _is_message_record(rec):
    if rec.get("type") in MESSAGE_TYPES:
        return True
    return "role" in rec or isinstance(rec.get("message"), (dict, str))


def peek_transcript(path):
    """Light metadata scan of one transcript. Never builds a trajectory.

    Returns dict(times, cwd, sid, records, user_messages, preview) — enough to
    date-filter, group by project and label a session in the exclusion menu.
    """
    found = {"times": [], "cwd": None, "sid": None, "records": 0,
             "user_messages": 0, "preview": None, "entrypoint": None}
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return found
    stripped = raw.lstrip()
    docs = []
    if stripped.startswith(("{", "[")):
        try:                                  # single JSON document
            doc = json.loads(raw)
            docs = doc if isinstance(doc, list) else [doc]
            for container in ("messages", "entries", "history", "conversation"):
                if isinstance(doc, dict) and isinstance(doc.get(container), list):
                    docs = [doc] + [m for m in doc[container] if isinstance(m, dict)]
                    break
        except (json.JSONDecodeError, ValueError):
            docs = []
    if not docs:                              # JSONL
        docs = []
        # "\n" only: str.splitlines() also breaks on U+2028 and U+0085, which
        # occur raw inside JSON strings and would split a record in two.
        for line in raw.split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except (json.JSONDecodeError, ValueError):
                continue
            if isinstance(rec, dict):
                docs.append(rec)

    candidates, seen_users = [], set()
    for rec in docs:
        if not isinstance(rec, dict):
            continue
        _scan_record(rec, found)
        for key in NESTED_KEYS:
            nested = rec.get(key)
            if isinstance(nested, dict):
                _scan_record(nested, found)
        if _is_message_record(rec):
            found["records"] += 1
        if not found["entrypoint"] and isinstance(rec.get("entrypoint"), str):
            found["entrypoint"] = rec["entrypoint"]
        kind = _user_record_kind(rec)
        uuid = rec.get("uuid")
        if kind is None or (uuid and uuid in seen_users):
            continue
        seen_users.add(uuid)
        text = _record_text(rec)
        candidates.append((text, kind))
        if found["preview"] is None:
            clean = " ".join(INJECTED_BLOCK_RE.sub("", text).split())
            if clean and not clean.startswith(INJECTED_PREFIXES):
                found["preview"] = clean[:70]
    if not (found["entrypoint"] or "").startswith(SCRIPTED_ENTRYPOINTS):
        found["user_messages"] = count_user_messages(candidates)
    return found


